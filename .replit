modules = ["nodejs-24", "postgresql-16"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd final-year-project-skillyug-sponsored-main/final-year-project-skillyug-sponsored-main && (npm run server & npm run dev)"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002

[[ports]]
localPort = 3003
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 80

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd final-year-project-skillyug-sponsored-main/final-year-project-skillyug-sponsored-main && node server.js"]
build = ["bash", "-c", "cd final-year-project-skillyug-sponsored-main/final-year-project-skillyug-sponsored-main && npm run build"]
